{
  "name": "term-ui",
  "version": "0.2.0",
  "type": "module",
  "description": "Terminal-CLI styled React component library — 20 components, 4 phosphor themes + custom HEX picker.",
  "keywords": [
    "react",
    "component-library",
    "terminal",
    "cli",
    "design-system",
    "phosphor",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/23mnals/term-ui.git"
  },
  "main": "./dist-lib/term-ui.js",
  "exports": {
    ".": {
      "import": "./dist-lib/term-ui.js"
    },
    "./style.css": "./dist-lib/term-ui.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "files": [
    "dist-lib",
    "src",
    "docs",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build -c vite.lib.config.js",
    "preview": "vite preview",
    "prepare": "npm run build:lib"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "vite": "^5.4.8"
  }
}
